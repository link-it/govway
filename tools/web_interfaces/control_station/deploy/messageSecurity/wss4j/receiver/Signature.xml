<config id="messageSecurity.wss4j.receiver.signature" label="WS-Security Signature" xmlns="http://www.openspcoop2.org/core/mvc/properties"
	provider="org.openspcoop2.security.message.wss4j.SignatureReceiverProvider">

        <compatibility not="false" and="false">
                <tags and="true">
                        <tag>SOAP</tag>
                        <tag>RESPONSE</tag>
                        <tag>OUT</tag>
                </tags>
                <tags and="true">
                        <tag>SOAP</tag>
                        <tag>REQUEST</tag>
                        <tag>IN</tag>
                </tags>
        </compatibility>
	
	<properties>
		<collection name="signaturePropRefId"/>
	</properties>
	
	<section label="Informazioni Generali">
		
		<item type="hidden" name="securityEngine" value="wss4j">
			<property name="securityEngine" force="true"/>
		</item>
		
		<item type="textarea" name="actor" singleLine="true" label="Actor" required="false" validation="(.+)">
			<property name="actor" />
		</item>
		<item type="checkbox" name="mustUnderstand" label="MustUnderstand" defaultSelected="false">
			<property name="mustUnderstand" />
		</item>
		<item type="checkbox" name="timestampAction" label="Timestamp" reloadOnChange="true" defaultSelected="false">
			<property name="action" append="true" appendSeparator=" " selectedValue="Timestamp" unselectedValue=""/>
		</item>
		<item type="hidden" name="signatureAction" value="Signature">
			<property name="action" append="true" appendSeparator=" " force="true"/>
		</item>
		
		<item type="checkbox" name="isBSPCompliant" label="Compliance BSP 1.1" defaultSelected="true">
			<property name="isBSPCompliant" />
		</item>		
		<item type="checkbox" name="signatureCleanSecurityInfo" label="Ripulisci Messaggio dalle Informazioni Sicurezza" defaultSelected="true">
			<property name="detachSecurityInfo" />
		</item>

	</section>

	<section label="Timestamp">
	
		<conditions>
			<condition>
				<selected name="timestampAction"/>
			</condition>
		</conditions>
	
		<item type="number" name="futureTimeToLive" label="Future Time to Live (seconds)" min="1" max="999999999" default="60"
			note="The time in seconds in the future within which the Created time of an incoming Timestamp is valid">
			<property name="futureTimeToLive" />
		</item>
	</section>

	<section label="Signature">

		<!-- Verifica degli elementi protetti (opzionale): se indicati, il messaggio deve contenere esattamente gli elementi cifrati/firmati attesi.
		     Il valore predefinito non verifica alcun elemento, come le configurazioni precedenti in cui la proprietà non è presente. -->
		<item type="select" name="signaturePartsVerifySelectWithTimestamp" label="Elementi firmati attesi" default="none" reloadOnChange="true"
			note="Gli elementi firmati devono corrispondere a quelli indicati.&lt;BR/>Con 'Qualsiasi' non ne viene richiesto nessuno in particolare e viene verificata la firma di quelli presenti">
			<conditions>
				<condition>
					<selected name="timestampAction"/>
				</condition>
			</conditions>
			<values>
				<value value="none" label="Qualsiasi"/>
				<value value="body" label="Body"/>
				<value value="timestamp" label="Timestamp"/>
				<value value="timestampBody" label="Timestamp Body"/>
				<value value="attachments" label="Attachments"/>
				<value value="timestampAttachments" label="Timestamp Attachments"/>
				<value value="bodyAttachments" label="Body Attachments"/>
				<value value="timestampBodyAttachments" label="Timestamp Body Attachments"/>
				<value value="custom" label="Configurazione Manuale"/>
			</values>
			<property name="signaturePartsVerifySelectWithTimestamp" />
		</item>
		<item type="select" name="signaturePartsVerifySelect" label="Elementi firmati attesi" default="none" reloadOnChange="true"
			note="Gli elementi firmati devono corrispondere a quelli indicati.&lt;BR/>Con 'Qualsiasi' non ne viene richiesto nessuno in particolare e viene verificata la firma di quelli presenti">
			<conditions>
				<condition not="true">
					<selected name="timestampAction"/>
				</condition>
			</conditions>
			<values>
				<value value="none" label="Qualsiasi"/>
				<value value="body" label="Body"/>
				<value value="attachments" label="Attachments"/>
				<value value="bodyAttachments" label="Body Attachments"/>
				<value value="custom" label="Configurazione Manuale"/>
			</values>
			<property name="signaturePartsVerifySelect" />
		</item>
		<item type="hidden" name="signaturePartsVerifyBody" value="{Element}{SOAP_TEMPLATE_NS}Body">
			<conditions and="false">
				<condition>
					<equals name="signaturePartsVerifySelect" value="body"/>
				</condition>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="body"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyTimestamp" value="{Element}{http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd}Timestamp">
			<conditions>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="timestamp"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyTimestampBody" value="{Element}{http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd}Timestamp;{Element}{SOAP_TEMPLATE_NS}Body">
			<conditions>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="timestampBody"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyAttachments" value="{}cid:Attachments">
			<conditions and="false">
				<condition>
					<equals name="signaturePartsVerifySelect" value="attachments"/>
				</condition>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="attachments"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyTimestampAttachments" value="{Element}{http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd}Timestamp;{}cid:Attachments">
			<conditions>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="timestampAttachments"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyBodyAttachments" value="{Element}{SOAP_TEMPLATE_NS}Body;{}cid:Attachments">
			<conditions and="false">
				<condition>
					<equals name="signaturePartsVerifySelect" value="bodyAttachments"/>
				</condition>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="bodyAttachments"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="hidden" name="signaturePartsVerifyTimestampBodyAttachments" value="{Element}{http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd}Timestamp;{Element}{SOAP_TEMPLATE_NS}Body;{}cid:Attachments">
			<conditions>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="timestampBodyAttachments"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>
		<item type="textarea" name="signaturePartsVerifyCustom" label="Elementi Attesi" required="true" note="{Element}{namespace}localName separati da ; (cid:Attachments in localName per gli allegati SWA)">
			<conditions and="false">
				<condition>
					<equals name="signaturePartsVerifySelect" value="custom"/>
				</condition>
				<condition>
					<equals name="signaturePartsVerifySelectWithTimestamp" value="custom"/>
				</condition>
			</conditions>
		    <property name="signatureParts" />
		</item>

		<!-- Algoritmi accettati (opzionale): con 'Qualsiasi' non viene impostata alcuna proprietà, come nelle configurazioni precedenti. -->
		<item type="select" name="signatureAlgorithmVerifySelect" label="Algoritmi accettati" default="any" reloadOnChange="true"
			note="Con 'Qualsiasi' viene accettato ogni algoritmo supportato; con 'Elenco' solo quelli indicati">
			<values>
				<value value="any" label="Qualsiasi"/>
				<value value="list" label="Elenco"/>
			</values>
			<property name="signatureAlgorithmVerifySelect" />
		</item>
		<item type="textarea" name="signatureAlgorithmVerifyList" label="Signature Algorithm" required="true" default="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"
			note="URI degli algoritmi di firma accettati, separati da ','">
			<conditions>
				<condition>
					<equals name="signatureAlgorithmVerifySelect" value="list"/>
				</condition>
			</conditions>
		    <property name="signatureAlgorithm" />
		</item>
		<!-- obbligatorio: sempre salvato, così alla riapertura il default non può introdurre una restrizione non configurata -->
		<item type="textarea" name="signatureDigestAlgorithmVerifyList" label="Digest Algorithm" required="true" default="http://www.w3.org/2001/04/xmlenc#sha256"
			note="URI degli algoritmi di digest accettati nei riferimenti della firma, separati da ','">
			<conditions>
				<condition>
					<equals name="signatureAlgorithmVerifySelect" value="list"/>
				</condition>
			</conditions>
		    <property name="signatureDigestAlgorithm" />
		</item>


		<subsection label="TrustStore">

			<item type="hidden" name="signatureCryptoProvider" value="org.openspcoop2.security.keystore.MerlinProvider">
				<property name="org.apache.ws.security.crypto.provider" force="true" properties="signaturePropRefId"/>
			</item>

			<item type="select" name="keystoreType" label="Tipo" default="jks" reloadOnChange="true">
				<property name="org.apache.ws.security.crypto.merlin.keystore.type" properties="signaturePropRefId" />
			</item>
			<item type="textarea" name="keystoreFile" label="Path" required="true">
			      	<property name="org.apache.ws.security.crypto.merlin.file" properties="signaturePropRefId" />
			</item>
			<item type="lock" name="keystorePassword" label="Password" required="true">
			      	<property name="org.apache.ws.security.crypto.merlin.keystore.password" properties="signaturePropRefId" />
			</item>
			<!-- NON SERVE
			<item type="text" name="keystoreCertificateAlias" label="Alias Certificato" required="false">
			      	<property name="signatureUser" />
			</item>
			-->
			<item type="select" name="keystoreOcspPolicy" label="OCSP Policy" default="" reloadOnChange="true">
				<property name="signatureOCSP" />
			</item>
			<item type="checkbox" name="enableRevocation" label="CRL" reloadOnChange="true" defaultSelected="false">
				<conditions>
					<condition and="false">
						<defined not="true" name="keystoreOcspPolicy"/>
						<equals name="keystoreOcspPolicy" value=""/>
					</condition>
				</conditions>
				<property name="enableRevocation" />
			</item>	
			<item type="textarea" name="crlFiles" label="CRL File(s)" required="true" note="Elencare più file separandoli con la ','">
				<conditions>
					<condition>
						<selected name="enableRevocation"/>
					</condition>
				</conditions>
			      	<property name="org.apache.ws.security.crypto.merlin.x509crl.file" properties="signaturePropRefId" />
			</item>
			<item type="textarea" name="crlFilesOcsp" label="CRL File(s)" required="false" note="Elencare più file separandoli con la ','">
				<conditions>
					<condition and="true">
						<defined name="keystoreOcspPolicy"/>
						<equals not="true" name="keystoreOcspPolicy" value=""/>
					</condition>
				</conditions>
			      	<property name="signatureCRL" />
			</item>

		</subsection>

	</section>

</config>



