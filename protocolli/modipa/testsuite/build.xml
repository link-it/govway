<project name="GovWayMonitorMondipaTestSuite">

	<description>
        	File di Script per la compilazione dell'interfaccia api rs per il Monitoraggio
    	</description>

	<import file="./local_env.xml" />

	<!-- estensione di ant (if .... ) -->
	<taskdef resource="net/sf/antcontrib/antlib.xml">
		<classpath>
			<pathelement location="${required_lib}/ant/ant-contrib-1.0b3.jar"/>
		</classpath>
	</taskdef>

	<path id="karate_testsuite" >
		<fileset dir="${required_lib}/testsuite/karate09" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/testsuite/junit4" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/testsuite/logback" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/testsuite/httpcore4" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/testsuite/spring5" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/testsuite/json-path2" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${dir_jdbc}" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/commons" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/log" >
			<include name="*.jar"/>
			<exclude name="log4j-slf4j2-impl-2.26.1.jar"/> <!-- per evitare errore SLF4J(W): Class path contains multiple SLF4J providers. (uso logback) -->
		</fileset>
		<fileset dir="${required_lib}/json" >
			<include name="*.jar"/>
			<exclude name="json-path-3.0.0-gov4j-1.jar"/>
		</fileset>
                <fileset dir="${required_lib}/shared" >
                        <include name="snakeyaml-2.6-gov4j-1.jar"/>
			<include name="joda-time-2.14.1.jar"/>
                </fileset>
                <fileset dir="${required_lib}/jakarta" >
                        <include name="jakarta.activation-api-2.1.4.jar"/>
                </fileset>
                <fileset dir="${required_lib}/cxf" >
                        <include name="asm-9.10.1.jar"/>
                </fileset>
		<fileset dir="${required_lib}/angus" >
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${required_lib}/httpcore" >
			<include name="*.jar"/>
		</fileset>
	</path>
	<path id="karate_testsuite_dist_govway_java11" >
		<fileset dir="${openspcoop2.utils.dist_java11}" >
                        <include name="*.jar"/>
                </fileset>
	</path>  
	<path id="karate_testsuite_dist_govway" >
		<fileset dir="${openspcoop2.dist}" >
                        <include name="*.jar"/>
                </fileset>
	</path> 

	<property name="src_testsuite" location="src" />
	<property name="build_testsuite" location="build" />
	<property name="dist_testsuite" location="dist" />
	<!-- Bundle principale: caricato per primo ed eliminato per ultimo, poiché gli altri bundle (es. extraTestBundle.zip) ne utilizzano soggetti e applicativi -->
	<property name="modipa_main_bundle" value="modipaTestBundle.zip" />

	<!-- Ripulisce la distribuzione -->
	<target name="clean">
		<delete dir="${build_testsuite}"/>
		<delete dir="log"/>
		<delete dir="target"/>
	</target>
	<target name="init">
		<mkdir dir="${build_testsuite}"/>
	</target>

	<!-- Compilazione del Client -->
	<target name="build" depends="clean,init" description="compila" >
		<!-- Compile the java code  -->
		<javac includeantruntime="false" destdir="${build_testsuite}" debug="${debug}">
			<src path="${src_testsuite}"/>
			<exclude name="org/openspcoop2/core/protocolli/modipa/testsuite/handler/*"/>
			<classpath>
				<path refid="karate_testsuite"/>
				<path refid="karate_testsuite_dist_govway_java11"/>
			</classpath>
		</javac>
		<copy todir="${build_testsuite}">
			<fileset dir="${src_testsuite}">
				<exclude name="**/*.java"/>
			</fileset>
		</copy>
	</target>
	<target name="build_plugin_handler" depends="clean,init" description="compila l'handler" > <!-- da compilare con java 21 -->
		<!-- Compile the java code  -->
		<javac includeantruntime="false" destdir="${build_testsuite}" debug="${debug}">
			<src path="${src_testsuite}"/>
			<include name="org/openspcoop2/core/protocolli/modipa/testsuite/handler/*"/>
			<classpath>
				<path refid="karate_testsuite"/>
				<path refid="karate_testsuite_dist_govway"/>
			</classpath>
		</javac>
		<jar jarfile="${dist_testsuite}/govway_modi_testsuite_handlers.jar">
			<zipfileset dir="${build_testsuite}">
				<include name="org/openspcoop2/core/protocolli/modipa/testsuite/handler/*"/>
			</zipfileset>
		</jar>
	</target>

	<!-- Esecuzione dei test -->

	<target name="delete_config"> <!-- da eseguire con java 21 -->
		<echo message="Eliminazione configurazione in corso ..." />
		<antcall target="-delete_config">
			<param name="deleteConfig" value="true"/>
		</antcall>
		<echo message="Eliminazione configurazione effettuata" />
	</target>

	<target name="load_config"> <!-- da eseguire con java 21 -->
		<echo message="Caricamento configurazione in corso (delete) ..." />
		<antcall target="-delete_config">
			<param name="deleteConfig" value="true"/>
		</antcall>
		<echo message="Caricamento configurazione in corso (create) ..." />
		<antcall target="-load_config">
			<param name="loadConfig" value="true"/>
		</antcall>
		<echo message="Caricamento configurazione completata" />
	</target>
	
	<target name="load_only_config">
		<echo message="Caricamento configurazione in corso (create senza delete) ..." />
		<antcall target="-load_config">
			<param name="loadConfig" value="true"/>
		</antcall>
		<echo message="Caricamento configurazione (senza delete) completata" />
	</target>	

	<target name="run_test">

		<delete dir="${output}"/>
		<mkdir dir="${output}"/>

		<!-- da eseguire con java 21 -->
		<antcall target="-delete_config">
			<param name="deleteConfig" value="${load}"/>
		</antcall>
		<antcall target="-load_config">
			<param name="loadConfig" value="${load}"/>
		</antcall>

		<var name="karateparams" value=""/>
		<if>
			<not>
				<equals arg1="${karate.options}" arg2="$${karate.options}"/>
			</not>
			<then>
				<var name="karateparams" value="-Dkarate.options=${build_testsuite}/${karate.options}"/>
			</then>
		</if>

                <fileset dir="${src_testsuite}" id="absoluteTestClassNames">
                        <include name="**/*Test.java"/>
                </fileset>
		<pathconvert property="testClassNames" refid="absoluteTestClassNames" pathsep=",">
			<chainedmapper>
				<flattenmapper/>
				<globmapper from="*.java" to="*" casesensitive="no"/>
			</chainedmapper>
		</pathconvert>

		<var name="karatetest" value="${testClassNames}"/>
		<if>
			<not>
				<equals arg1="${test}" arg2="$${test}"/>
			</not>
			<then>
				<var name="karatetest" value="${test}"/>
			</then>
		</if>
		<echo message="Esecuzione delle seguenti classi di test: ${karatetest}"/>

		<for list="${karatetest}" param="karateTipoTest">
			<sequential>
				<mkdir dir="${output}/@{karateTipoTest}"/>
				<if>
					<equals arg1="${karateparams}" arg2=""/>
					<then>
						<junit printsummary="yes" haltonfailure="${haltOnFailure}" showoutput="${showOutput}">

							<!-- Per non far comparire il Warning: Nashorn engine is planned to be removed from a future JDK release -->
							<jvmarg value="-Dnashorn.args=--no-deprecation-warning"/>

							<!-- Per non far comparire il WARNING: Illegal reflective access by net.minidev.asm.DynamicClassLoader 
							     (file:.../lib/json/accessors-smart-2.6.0.jar) to method java.lang.ClassLoader.defineClass(java.lang.String,byte[],int,int) -->
							<!-- Modificato da deny a permit per non far comparire il messaggio (sono test): 
								Caused by: java.lang.IllegalAccessError: class Log4jHotPatch (in unnamed module @0x7a356a0d) 
									cannot access class jdk.internal.org.objectweb.asm.Opcodes (in module java.base) 
									because module java.base does not export jdk.internal.org.objectweb.asm to unnamed module @0x7a356a0d
									at Log4jHotPatch.asmVersion(Log4jHotPatch.java:71)
							-->
							<jvmarg value="-Djdk.module.illegalAccess=permit"/>

							<classpath refid="karate_testsuite" />
							<classpath refid="karate_testsuite_dist_govway_java11"/>
							<classpath location="${build_testsuite}" />

							<formatter type="plain"/>			
							<formatter type="xml" />

							<batchtest fork="yes" todir="${output}/@{karateTipoTest}">
								<fileset dir="${src_testsuite}">
									<include name="**/@{karateTipoTest}.java" />
								</fileset>
							</batchtest>
				
						 </junit>
					</then>
					<else>
						<junit printsummary="yes" haltonfailure="${haltOnFailure}" showoutput="${showOutput}">

							<jvmarg value="${karateparams}"/>

							<!-- Per non far comparire il Warning: Nashorn engine is planned to be removed from a future JDK release -->
							<jvmarg value="-Dnashorn.args=--no-deprecation-warning"/>

							<!-- Per non far comparire il WARNING: Illegal reflective access by net.minidev.asm.DynamicClassLoader 
							     (file:.../lib/json/accessors-smart-2.6.0.jar) to method java.lang.ClassLoader.defineClass(java.lang.String,byte[],int,int) -->
							<!-- Modificato da deny a permit per non far comparire il messaggio (sono test): 
								Caused by: java.lang.IllegalAccessError: class Log4jHotPatch (in unnamed module @0x7a356a0d) 
									cannot access class jdk.internal.org.objectweb.asm.Opcodes (in module java.base) 
									because module java.base does not export jdk.internal.org.objectweb.asm to unnamed module @0x7a356a0d
									at Log4jHotPatch.asmVersion(Log4jHotPatch.java:71)
							-->
							<jvmarg value="-Djdk.module.illegalAccess=permit"/>

							<classpath refid="karate_testsuite" />
							<classpath refid="karate_testsuite_dist_govway_java11"/>
							<classpath location="${build_testsuite}" />

							<formatter type="plain"/>			
							<formatter type="xml" />

							<batchtest fork="yes" todir="${output}/@{karateTipoTest}">
								<fileset dir="${src_testsuite}">
									<include name="**/@{karateTipoTest}.java" />
								</fileset>
							</batchtest>
				
						 </junit>				
					</else>
				</if>
			</sequential>
		</for>

		<!-- da eseguire con java 21 -->
		<antcall target="-delete_config">
			<param name="deleteConfig" value="${delete}"/>
		</antcall>

		<junitreport todir="${output}">
			<fileset dir="${output}">
				<include name="**/TEST-*.xml" />
			</fileset>
			<report format="frames" todir="${output}\html\" />
		</junitreport>

	</target>

	<!-- Caricamento ed eliminazione dei bundle di configurazione -->
	<!-- Il parametro (load/delete) può valere 'true' (tutti gli archivi *.zip presenti in configurazioni-govway), 'false' oppure una lista di archivi separati da ':' (es. extraTestBundle.zip) -->

	<target name="-load_config">
		<var name="loadFiles" value=""/>
		<if>
			<or>
				<equals arg1="${loadConfig}" arg2="$${load}"/>
				<equals arg1="${loadConfig}" arg2="true" />
			</or>
			<then>
				<path id="configurazione.files">
					<fileset dir="${src_testsuite}/configurazioni-govway">
						<include name="*.zip"/>
						<exclude name="${modipa_main_bundle}"/>
					</fileset>
				</path>
				<!-- solo il nome dell'archivio (il path restituito dal fileset è assoluto) -->
				<pathconvert property="loadFileProp" refid="configurazione.files" pathsep=":">
					<flattenmapper/>
				</pathconvert>
				<if>
					<equals arg1="${loadFileProp}" arg2=""/>
					<then>
						<var name="loadFiles" value="${modipa_main_bundle}"/>
					</then>
					<else>
						<var name="loadFiles" value="${modipa_main_bundle}:${loadFileProp}"/>
					</else>
				</if>
			</then>
			<elseif>
				<not>
					<equals arg1="${loadConfig}" arg2="false" />
				</not>
				<then>
					<var name="loadFiles" value="${loadConfig}"/>
				</then>
			</elseif>
		</if>

		<echo message="Bundle selezionati creazione: [${loadFiles}]" />
		<for list="${loadFiles}" delimiter=":" param="loadFile">
			<sequential>
				<local name="filename" />
				<basename property="filename" file="@{loadFile}"/>
				<echo message="Bundle: ${filename}, caricamento configurazione in corso  ..." />
				<java classname="org.openspcoop2.core.protocolli.modipa.testsuite.ConfigLoader" fork="true">
					<arg value="true" />
					<arg value="${src_testsuite}/configurazioni-govway/${filename}" />
					<classpath>
						<path refid="karate_testsuite" />
						<path refid="karate_testsuite_dist_govway"/>
						<pathelement path="${build_testsuite}"/>
					</classpath>
				</java>
				<echo message="Bundle: ${filename}, caricamento configurazione completata" />
			</sequential>
		</for>
	</target>

	<target name="-delete_config">
		<var name="deleteFiles" value=""/>
		<if>
			<or>
				<equals arg1="${deleteConfig}" arg2="$${delete}"/>
				<equals arg1="${deleteConfig}" arg2="$${load}"/>
				<equals arg1="${deleteConfig}" arg2="true" />
			</or>
			<then>
				<path id="configurazione.files">
					<fileset dir="${src_testsuite}/configurazioni-govway">
						<include name="*.zip"/>
						<exclude name="${modipa_main_bundle}"/>
					</fileset>
				</path>
				<!-- solo il nome dell'archivio (il path restituito dal fileset è assoluto) -->
				<pathconvert property="deleteFileProp" refid="configurazione.files" pathsep=":">
					<flattenmapper/>
				</pathconvert>
				<if>
					<equals arg1="${deleteFileProp}" arg2=""/>
					<then>
						<var name="deleteFiles" value="${modipa_main_bundle}"/>
					</then>
					<else>
						<var name="deleteFiles" value="${deleteFileProp}:${modipa_main_bundle}"/>
					</else>
				</if>
			</then>
			<elseif>
				<not>
					<equals arg1="${deleteConfig}" arg2="false" />
				</not>
				<then>
					<var name="deleteFiles" value="${deleteConfig}"/>
				</then>
			</elseif>
		</if>

		<echo message="Bundle selezionati eliminazione: [${deleteFiles}]" />
		<for list="${deleteFiles}" delimiter=":" param="deleteFile">
			<sequential>
				<local name="filename" />
				<basename property="filename" file="@{deleteFile}"/>
				<echo message="Bundle: ${filename}, eliminazione configurazione in corso ..." />
				<java classname="org.openspcoop2.core.protocolli.modipa.testsuite.ConfigLoader" fork="true">
					<arg value="false" />
					<arg value="${src_testsuite}/configurazioni-govway/${filename}" />
					<classpath>
						<path refid="karate_testsuite" />
						<path refid="karate_testsuite_dist_govway"/>
						<pathelement path="${build_testsuite}"/>
					</classpath>
				</java>
				<echo message="Bundle: ${filename}, eliminazione configurazione effettuata" />
			</sequential>
		</for>
	</target>

</project>
