<?xml version="1.0" encoding="UTF-8"?>
<!--
  API di callback di esempio per gli scambi di dati asincroni PDND (versione estesa).
  Erogata dal fruitore dell'e-service 'PDNDAsyncEServiceEstesa': l'operazione callbackInvocation corrisponde alla fase callback_invocation.
  Contiene inoltre operazioni sincrone che non partecipano allo scambio asincrono.
-->
<wsdl:definitions name="PDNDAsyncCallbackEstesa"
	targetNamespace="http://govway.org/example/modipa/pdnd/async/callback"
	xmlns:tns="http://govway.org/example/modipa/pdnd/async/callback"
	xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
	xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema">

	<wsdl:types>
		<xsd:schema targetNamespace="http://govway.org/example/modipa/pdnd/async/callback" elementFormDefault="qualified">
			<xsd:element name="callbackInvocation">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="status" type="xsd:string"/>
						<xsd:element name="entities" type="xsd:int" minOccurs="0"/>
						<xsd:element name="message" type="xsd:string" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="callbackInvocationResponse" type="tns:Ack"/>
			<xsd:complexType name="Ack">
				<xsd:sequence>
					<xsd:element name="outcome" type="xsd:string"/>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:element name="notifyError">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="message" type="xsd:string"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="notifyErrorResponse" type="tns:Ack"/>
			<xsd:element name="health">
				<xsd:complexType>
					<xsd:sequence/>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="healthResponse">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="status" type="xsd:string"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
		</xsd:schema>
	</wsdl:types>

	<wsdl:message name="callbackInvocationRequest">
		<wsdl:part name="parameters" element="tns:callbackInvocation"/>
	</wsdl:message>
	<wsdl:message name="callbackInvocationResponse">
		<wsdl:part name="parameters" element="tns:callbackInvocationResponse"/>
	</wsdl:message>
	<wsdl:message name="notifyErrorRequest">
		<wsdl:part name="parameters" element="tns:notifyError"/>
	</wsdl:message>
	<wsdl:message name="notifyErrorResponse">
		<wsdl:part name="parameters" element="tns:notifyErrorResponse"/>
	</wsdl:message>
	<wsdl:message name="healthRequest">
		<wsdl:part name="parameters" element="tns:health"/>
	</wsdl:message>
	<wsdl:message name="healthResponse">
		<wsdl:part name="parameters" element="tns:healthResponse"/>
	</wsdl:message>

	<wsdl:portType name="PDNDAsyncCallbackEstesaPortType">
		<wsdl:operation name="callbackInvocation">
			<wsdl:documentation>Invocazione della callback (callback_invocation)</wsdl:documentation>
			<wsdl:input message="tns:callbackInvocationRequest"/>
			<wsdl:output message="tns:callbackInvocationResponse"/>
		</wsdl:operation>
		<wsdl:operation name="notifyError">
			<wsdl:documentation>Segnalazione di un errore applicativo (operazione sincrona)</wsdl:documentation>
			<wsdl:input message="tns:notifyErrorRequest"/>
			<wsdl:output message="tns:notifyErrorResponse"/>
		</wsdl:operation>
		<wsdl:operation name="health">
			<wsdl:documentation>Stato del servizio (operazione sincrona)</wsdl:documentation>
			<wsdl:input message="tns:healthRequest"/>
			<wsdl:output message="tns:healthResponse"/>
		</wsdl:operation>
	</wsdl:portType>

	<wsdl:binding name="PDNDAsyncCallbackEstesaBinding" type="tns:PDNDAsyncCallbackEstesaPortType">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
		<wsdl:operation name="callbackInvocation">
			<soap:operation soapAction="callbackInvocation" style="document"/>
			<wsdl:input><soap:body use="literal"/></wsdl:input>
			<wsdl:output><soap:body use="literal"/></wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="notifyError">
			<soap:operation soapAction="notifyError" style="document"/>
			<wsdl:input><soap:body use="literal"/></wsdl:input>
			<wsdl:output><soap:body use="literal"/></wsdl:output>
		</wsdl:operation>
		<wsdl:operation name="health">
			<soap:operation soapAction="health" style="document"/>
			<wsdl:input><soap:body use="literal"/></wsdl:input>
			<wsdl:output><soap:body use="literal"/></wsdl:output>
		</wsdl:operation>
	</wsdl:binding>

	<wsdl:service name="PDNDAsyncCallbackEstesaService">
		<wsdl:port name="PDNDAsyncCallbackEstesaPort" binding="tns:PDNDAsyncCallbackEstesaBinding">
			<soap:address location="http://localhost:9302/"/>
		</wsdl:port>
	</wsdl:service>

</wsdl:definitions>
